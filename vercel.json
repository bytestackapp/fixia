{
  "version": 2, "name": "fixia",
  "builds": [
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "sw.js", "use": "@vercel/static" },
    { "src": "manifest.json", "use": "@vercel/static" },
    { "src": "api/**/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1.js" },
    { "src": "/sw.js", "dest": "/sw.js" },
    { "src": "/manifest.json", "dest": "/manifest.json" },
    { "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf))", "dest": "/public/$1" },
    { "src": "/(.+\\.html)", "dest": "/public/$1" },
    { "src": "/", "dest": "/public/presignup.html" },
    { "src": "/(.*)", "dest": "/public/$1.html" }
  ],
  "crons": [ { "path": "/api/subscription-cron", "schedule": "0 17 * * *" } ],
  "headers": [
    { "source": "/api/(.*)", "headers": [
      { "key": "Access-Control-Allow-Origin", "value": "*" },
      { "key": "Access-Control-Allow-Methods", "value": "POST, OPTIONS" },
      { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, x-session-token, x-user-id" } ] },
    { "source": "/(css|js|images)/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" } ] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" } ] }
  ]
}
